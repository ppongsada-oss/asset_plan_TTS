{
  "name": "asset-plan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "find . -type f -name '._*' -delete 2>/dev/null || true; next dev",
    "build": "npm run build:next && (find .next -type f -name '._*' -delete 2>/dev/null || true) && npx opennextjs-cloudflare build --skipNextBuild && rm -rf dist && mkdir -p dist && cp -R .open-next/. dist/ && (find dist -type f -name '._*' -delete 2>/dev/null || true)",
    "build:next": "rm -f .next/dev/lock; find . -type f -name '._*' -delete 2>/dev/null || true; next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/auth/*.test.ts tests/site-plans/*.test.ts",
    "test:auth": "node --import tsx --test tests/auth/*.test.ts",
    "test:rollback": "node --import tsx --test tests/site-plans/*.test.ts",
    "test:runtime": "node --import tsx scripts/runtime-access-regression.ts"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260430.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
